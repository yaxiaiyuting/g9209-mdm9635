+/* [MDM-bringup] 把聚合缓冲里的字节打包进 to_mdm_list（不持锁分配，锁内校验） */
+#define KSB_AGG_MAX   16384
+static void ksb_agg_flush_all(struct ks_bridge *ksb)
+{
+	unsigned long flags;
+	struct data_pkt *pkt;
+	int n;
+	unsigned int want;
+
+	spin_lock_irqsave(&ksb->lock, flags);
+	n = ksb->tx_acc_len;
+	spin_unlock_irqrestore(&ksb->lock, flags);
+	if (n <= 0 || n > ksb->tx_acc_sz)
+		return;
+
+	pkt = ksb_alloc_data_pkt(n, GFP_KERNEL, ksb);
+	if (IS_ERR(pkt))
+		return;
+
+	spin_lock_irqsave(&ksb->lock, flags);
+	if (ksb->tx_acc_len != n) {           /* 期间被改过 → 放弃本次，避免越界/错位 */
+		spin_unlock_irqrestore(&ksb->lock, flags);
+		ksb_free_data_pkt(pkt);
+		return;
+	}
+	want = (unsigned int)n;
+	memcpy(pkt->buf, ksb->tx_acc, want);
+	pkt->len = want;
+	ksb->tx_acc_len = 0;
+	ksb->req_left -= (int)want;           /* ★ 递减；减到 0 表示该请求发完 */
+	if (ksb->req_left < 0)
+		ksb->req_left = 0;
+	if (ksb->req_left == 0)
+		ksb->req_len = 0;
+	list_add_tail(&pkt->list, &ksb->to_mdm_list);
+	spin_unlock_irqrestore(&ksb->lock, flags);
+}
