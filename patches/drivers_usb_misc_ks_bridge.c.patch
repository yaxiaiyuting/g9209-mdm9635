 	struct data_pkt	*pkt;
+	ksb_agg_flush_all(ksb);               /* 先把聚合缓冲的残余打成包 */
+	if (ksb->tx_acc_len > 0) return;      /* 极小概率的竞争：下次再来 */
 	unsigned long flags;
 	struct urb *urb;
 	int ret;
@@ -382,11 +427,70 @@ static ssize_t ksb_fs_write(struct file *fp, const char __user *buf,
 		return ret;
 	}
 
+	/* [MDM-bringup] 诊断：打印 ks 实际写入的字节（纯打印，不改逻辑） */
+	{
+		static int n_small = 0, n_big = 0;
+		if (count <= 64) {
+			if (n_small < 40) {
+				print_hex_dump(KERN_INFO, "KSB-WC: ", DUMP_PREFIX_OFFSET, 16, 1,
+					       pkt->buf, count, false);
+				n_small++;
+			}
+		} else if (n_big < 2) {
+			print_hex_dump(KERN_INFO, "KSB-WD: ", DUMP_PREFIX_OFFSET, 16, 1,
+				       pkt->buf, count > 96 ? 96 : count, false);
+			n_big++;
+		}
+	}
+
+	/* [MDM-bringup v2] ks 的写入粒度是 4 字节（控制包与数据都一样）。
+	 * 三条件任一满足即冲刷：1) 成帧 2) 达阈值 3) 2ms 超时（由 delayed work 触发）。 */
+	if (count <= 8) {
+		unsigned int need; int full; int overflow;
+		spin_lock_irqsave(&ksb->lock, flags);
+		overflow = (ksb->tx_acc_len + (int)count > ksb->tx_acc_sz);
+		if (!overflow) {
+			memcpy(ksb->tx_acc + ksb->tx_acc_len, pkt->buf, count);
+			ksb->tx_acc_len += (int)count;
+		}
+		need = 8;
+		if (!overflow && ksb->tx_acc_len >= 8) {
+			unsigned int l = (unsigned int)ksb->tx_acc[4] | ((unsigned int)ksb->tx_acc[5] << 8) |
+					 ((unsigned int)ksb->tx_acc[6] << 16) | ((unsigned int)ksb->tx_acc[7] << 24);
+			if (l >= 8 && l <= 64)
+				need = l;                     /* 控制包：精确按头长度成帧 */
+			else if (ksb->req_left > 0) {
+				/* ★ 数据：按 modem 请求的剩余量分块（一次最多缓冲大小） */
+				need = (ksb->req_left > ksb->tx_acc_sz) ?
+					(unsigned int)ksb->tx_acc_sz : (unsigned int)ksb->req_left;
+			}
+			else
+				need = KSB_AGG_MAX;           /* 兜底阈值 */
+		}
+		full = (!overflow && ksb->tx_acc_len >= (int)need);
+		spin_unlock_irqrestore(&ksb->lock, flags);
+		ksb_free_data_pkt(pkt);
+		if (overflow) {
+			ksb_agg_flush_all(ksb);           /* 缓冲满：先冲掉，本次写入丢失风险最低 */
+			return count;
+		}
+		if (full) {
+			queue_work(ksb->wq, &ksb->to_mdm_work.work);
+		} else if (need == KSB_AGG_MAX || (ksb->req_left <= 0)) {
+			/* 控制包成帧未凑齐 / 兜底阈值：用 2ms 超时冲刷 */
+			schedule_delayed_work(&ksb->to_mdm_work, msecs_to_jiffies(2));
+		} else {
+			/* ★ 数据路径（等 modem 请求的整块）：**不设超时**，攒满即发，
+			 *   避免超时把 4096 的请求切成 3772 这种尺寸 ✗ */
+		}
+		return count;
+	}
+
 	spin_lock_irqsave(&ksb->lock, flags);
 	list_add_tail(&pkt->list, &ksb->to_mdm_list);
 	spin_unlock_irqrestore(&ksb->lock, flags);
 
-	queue_work(ksb->wq, &ksb->to_mdm_work);
+	queue_work(ksb->wq, &ksb->to_mdm_work.work);
 
 	return count;
 }
