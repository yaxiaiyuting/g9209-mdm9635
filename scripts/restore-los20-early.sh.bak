#!/bin/bash
# 一键回滚到 LOS 20（本次实验前的状态）
#
# 用法:
#   bash rollback-to-los20.sh            # 回滚 BOOT + SYSTEM + RECOVERY（推荐）
#   bash rollback-to-los20.sh --full     # 连基带/EFS 分区一起回滚
#
# 前提：设备能进系统(adb) 或 能进 TWRP
set -u
BK=/home/duanjb666/deepseek/G9209-fix/backup-20261003-full
BYNAME=/dev/block/platform/15570000.ufs/by-name

echo "=== 回滚到 LOS 20  $(date '+%F %T') ==="

# 基础三件套：boot / system / recovery
PARTS="BOOT SYSTEM RECOVERY"
[ "${1:-}" = "--full" ] && PARTS="$PARTS EFS RADIO m9kefs1 m9kefs2 m9kefs3 PARAM PERSDATA CACHE"

FAIL=0
for p in $PARTS; do
  IMG="$BK/$p.img"
  if [ ! -f "$IMG" ]; then echo "!! 缺少 $IMG，跳过"; FAIL=1; continue; fi

  WANT=$(stat -c %s "$IMG")
  echo "--- $p ($WANT 字节) ---"

  adb push "$IMG" "/data/local/tmp/rb_$p.img" 2>&1 | tail -1
  GOT=$(adb shell "md5sum /data/local/tmp/rb_$p.img" 2>/dev/null | cut -d' ' -f1 | tr -d '\r')
  LOCAL=$(md5sum "$IMG" | cut -d' ' -f1)
  if [ "$GOT" != "$LOCAL" ]; then
    echo "!! $p 推送后 md5 不符（设备 $GOT / 主机 $LOCAL），**跳过刷写**"
    FAIL=1; continue
  fi
  echo "    推送校验 OK ($GOT)"

  adb shell "dd if=/data/local/tmp/rb_$p.img of=$BYNAME/$p bs=1M 2>&1 | tail -1"
  adb shell "sync"

  # 回读校验
  R=$(adb shell "md5sum $BYNAME/$p" 2>/dev/null | cut -d' ' -f1 | tr -d '\r')
  if [ "$R" = "$LOCAL" ]; then
    echo "    ✅ 刷写校验通过"
  else
    echo "    ⚠️ 回读 md5 不同：设备 $R / 期望 $LOCAL"
    echo "       （若分区大于镜像，余下部分保持原样，md5 会不同——属正常，但请人工确认）"
  fi
  adb shell "rm -f /data/local/tmp/rb_$p.img"
done

echo
echo "=== 回滚结束，FAIL=$FAIL ==="
echo "重启: adb reboot"
echo
echo "参考 md5（应为）:"
grep -E "^[A-Za-z0-9_]+ size=" "$BK/MANIFEST.txt" | awk '{print "  " $1, substr($3,1,34)}'
exit $FAIL
